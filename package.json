{
  "name": "explainer",
  "version": "0.3.0",
  "description": "Video/audio/animation + text + diagrams on one reversible timeline",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./styleguide": "./dist/styleguide.js",
    "./experimental/flight": "./dist/experimental/flight.js",
    "./experimental/flight/pure": "./dist/experimental/flight/pure.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "dev": "vite --open /demo/",
    "build": "vite build",
    "prepare": "vite build",
    "test": "node --test test/ examples/",
    "render": "node scripts/render.mjs",
    "check:flight": "node examples/flight/check.mjs && node examples/flight/check-guide.mjs && node examples/flight/check-karaoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "linkedom": "^0.18.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-greenman/explainer.git"
  }
}
